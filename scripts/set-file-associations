#!/usr/bin/env python3
"""Preview, apply, or check the explicit macOS editor file associations."""
import argparse
from datetime import datetime
import json
from pathlib import Path
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]


def current(extension):
    result = subprocess.run(['duti', '-x', extension], capture_output=True, text=True)
    lines = result.stdout.strip().splitlines()
    return lines[-1] if result.returncode == 0 and len(lines) >= 3 else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--apply', action='store_true')
    mode.add_argument('--check', action='store_true')
    parser.add_argument('--app', help='override the application bundle ID')
    args = parser.parse_args()
    if sys.platform != 'darwin' or not shutil.which('duti'):
        parser.error('Requires macOS and duti (brew install duti).')
    config = json.loads((ROOT / 'macos/file-associations.json').read_text())
    application = args.app or config['application']
    previous = {ext: current(ext) for ext in config['extensions']}
    changes = {ext: old for ext, old in previous.items() if old != application}
    if args.check:
        for ext, old in changes.items():
            print(f'.{ext}: {old or "no default"}; expected {application}')
        if not changes:
            print(f'All {len(previous)} file associations use {application}.')
        return int(bool(changes))
    if not args.apply:
        for ext, old in changes.items():
            print(f'.{ext}: {old or "no default"} -> {application}')
        print('Preview only. Rerun with --apply to update associations.')
        return 0
    if not changes:
        print('File associations already match.')
        return 0
    backup = Path.home() / '.local/state/dotfiles' / ('file-associations-' + datetime.now().strftime('%Y%m%d-%H%M%S-%f') + '.json')
    backup.parent.mkdir(parents=True, exist_ok=True)
    backup.write_text(json.dumps(previous, indent=2) + '\n')
    print(f'Previous associations saved to {backup}', flush=True)
    for ext in changes:
        result = subprocess.run(['duti', '-s', application, '.' + ext, 'all'], capture_output=True, text=True)
        if result.returncode:
            print(f'.{ext}: macOS rejected the association ({result.stderr.strip()})', file=sys.stderr)
    actual = {ext: current(ext) for ext in previous}
    failures = {ext: handler for ext, handler in actual.items() if handler != application}
    # LaunchServices publishes updates asynchronously; immediate queries may
    # still return the old handler even after a successful duti call.
    for _ in range(12):
        if not failures:
            break
        time.sleep(0.25)
        actual = {ext: current(ext) for ext in failures}
        failures = {ext: handler for ext, handler in actual.items() if handler != application}
    if failures:
        for ext, handler in failures.items():
            print(f'.{ext}: still {handler or "unregistered"}', file=sys.stderr)
        return 1
    print(f'All {len(previous)} file associations now use {application}.')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f'File associations: {error}', file=sys.stderr)
        sys.exit(1)
