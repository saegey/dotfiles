#!/usr/bin/env python3
"""Preview/install a persistent system Docker socket link to the current user's Kiri."""
import argparse
import os
from pathlib import Path
import plistlib
import subprocess
import sys
import tempfile

LABEL = 'local.dotfiles.kiri-docker-socket'


def configuration(home):
    return {
        'Label': LABEL,
        'ProgramArguments': ['/bin/ln', '-sfn', str(home / '.kiri/run/docker.sock'), '/var/run/docker.sock'],
        'RunAtLoad': True,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true', help='install using sudo; run as your regular user')
    args = parser.parse_args()
    if sys.platform != 'darwin':
        parser.error('This setup uses macOS launchd')
    if os.geteuid() == 0:
        parser.error('Run as your regular user; the installer invokes sudo only for system changes')
    home = Path.home()
    target = home / '.kiri/run/docker.sock'
    link = Path('/var/run/docker.sock')
    destination = Path('/Library/LaunchDaemons') / (LABEL + '.plist')
    if not target.is_socket():
        parser.error('Start Kiri first; its Docker socket is not available')
    if link.exists() and not link.is_symlink():
        parser.error('/var/run/docker.sock is not a symlink; refusing to replace it')
    data = configuration(home)
    if destination.exists() and plistlib.loads(destination.read_bytes()) != data:
        parser.error(f'{destination} already has different settings; review it before replacing')
    print(f'Link {link} -> {target}')
    print(f'Restore at boot using {destination}')
    if not args.apply:
        print('Preview only; rerun with --apply and enter your administrator password locally.')
        return 0
    subprocess.run(['sudo', '-v'], check=True)
    with tempfile.TemporaryDirectory(prefix='kiri-socket-') as directory:
        temporary = Path(directory) / (LABEL + '.plist')
        temporary.write_bytes(plistlib.dumps(data))
        subprocess.run(['sudo', '/usr/bin/install', '-o', 'root', '-g', 'wheel', '-m', '644',
                        str(temporary), str(destination)], check=True)
    subprocess.run(['sudo', '/bin/launchctl', 'bootout', 'system/' + LABEL],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['sudo', '/bin/launchctl', 'bootstrap', 'system', str(destination)], check=True)
    # Run explicitly too, so verification does not race launchd's initial run.
    subprocess.run(['sudo', *data['ProgramArguments']], check=True)
    if not link.is_symlink() or os.readlink(link) != str(target):
        raise RuntimeError('Docker socket link was not installed')
    subprocess.run(['docker', '--host', 'unix:///var/run/docker.sock', 'version'], check=True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f'setup-kiri-socket: {error}', file=sys.stderr)
        sys.exit(1)
