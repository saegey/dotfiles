{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dotfiles Desktop",
  "author": "dotfiles",
  "themes": [
    {
      "name": "Dotfiles Desktop",
      "appearance": "dark",
      "style": {
        "background": "#272e33",
        "surface.background": "#2e383c",
        "elevated_surface.background": "#2e383c",
        "border": "#414b50",
        "border.focused": "#a7c080",
        "text": "#d3c6aa",
        "text.muted": "#859289",
        "text.accent": "#a7c080",
        "icon": "#d3c6aa",
        "icon.muted": "#859289",
        "editor.background": "#272e33",
        "editor.foreground": "#d3c6aa",
        "editor.gutter.background": "#272e33",
        "editor.line_number": "#859289",
        "editor.active_line_number": "#a7c080",
        "editor.active_line.background": "#2e383c",
        "panel.background": "#2e383c",
        "toolbar.background": "#2e383c",
        "tab_bar.background": "#2e383c",
        "tab.active_background": "#272e33",
        "tab.inactive_background": "#2e383c",
        "status_bar.background": "#2e383c",
        "title_bar.background": "#2e383c",
        "title_bar.inactive_background": "#2e383c",
        "terminal.background": "#272e33",
        "terminal.foreground": "#d3c6aa",
        "terminal.bright_foreground": "#edeada",
        "error": "#e67e80",
        "warning": "#dbbc7f",
        "success": "#a7c080",
        "info": "#7fbbb3",
        "created": "#a7c080",
        "deleted": "#e67e80",
        "modified": "#dbbc7f",
        "terminal.ansi.black": "#272e33",
        "terminal.ansi.bright_black": "#859289",
        "terminal.ansi.red": "#e67e80",
        "terminal.ansi.bright_red": "#e67e80",
        "terminal.ansi.green": "#a7c080",
        "terminal.ansi.bright_green": "#a7c080",
        "terminal.ansi.yellow": "#dbbc7f",
        "terminal.ansi.bright_yellow": "#dbbc7f",
        "terminal.ansi.blue": "#7fbbb3",
        "terminal.ansi.bright_blue": "#7fbbb3",
        "terminal.ansi.magenta": "#d699b6",
        "terminal.ansi.bright_magenta": "#d699b6",
        "terminal.ansi.cyan": "#83c092",
        "terminal.ansi.bright_cyan": "#83c092",
        "terminal.ansi.white": "#edeada",
        "terminal.ansi.bright_white": "#fffbef",
        "players": [
          {
            "cursor": "#d3c6aa",
            "background": "#a7c080",
            "selection": "#414b5080"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#859289"
          },
          "string": {
            "color": "#a7c080"
          },
          "keyword": {
            "color": "#a7c080"
          },
          "number": {
            "color": "#e69875"
          },
          "boolean": {
            "color": "#e69875"
          },
          "function": {
            "color": "#7fbbb3"
          },
          "type": {
            "color": "#dbbc7f"
          },
          "operator": {
            "color": "#83c092"
          },
          "variable": {
            "color": "#d3c6aa"
          },
          "punctuation": {
            "color": "#edeada"
          },
          "property": {
            "color": "#7fbbb3"
          },
          "tag": {
            "color": "#e67e80"
          }
        }
      }
    }
  ]
}
