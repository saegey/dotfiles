{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dotfiles Desktop",
  "author": "dotfiles",
  "themes": [
    {
      "name": "Dotfiles Desktop",
      "appearance": "light",
      "style": {
        "background": "#faf4ed",
        "surface.background": "#fffaf3",
        "elevated_surface.background": "#f2e9e1",
        "border": "#cecacd",
        "border.focused": "#d7827e",
        "text": "#464261",
        "text.muted": "#9893a5",
        "text.accent": "#d7827e",
        "icon": "#464261",
        "icon.muted": "#9893a5",
        "editor.background": "#faf4ed",
        "editor.foreground": "#464261",
        "editor.gutter.background": "#faf4ed",
        "editor.line_number": "#9893a5",
        "editor.active_line_number": "#d7827e",
        "editor.active_line.background": "#f2e9e1",
        "panel.background": "#fffaf3",
        "toolbar.background": "#fffaf3",
        "tab_bar.background": "#fffaf3",
        "tab.active_background": "#faf4ed",
        "tab.inactive_background": "#fffaf3",
        "status_bar.background": "#fffaf3",
        "title_bar.background": "#fffaf3",
        "title_bar.inactive_background": "#fffaf3",
        "terminal.background": "#faf4ed",
        "terminal.foreground": "#464261",
        "terminal.bright_foreground": "#797593",
        "error": "#b4637a",
        "warning": "#ea9d34",
        "success": "#286983",
        "info": "#56949f",
        "created": "#286983",
        "deleted": "#b4637a",
        "modified": "#ea9d34",
        "terminal.ansi.black": "#464261",
        "terminal.ansi.bright_black": "#9893a5",
        "terminal.ansi.red": "#b4637a",
        "terminal.ansi.bright_red": "#b4637a",
        "terminal.ansi.green": "#286983",
        "terminal.ansi.bright_green": "#286983",
        "terminal.ansi.yellow": "#ea9d34",
        "terminal.ansi.bright_yellow": "#ea9d34",
        "terminal.ansi.blue": "#56949f",
        "terminal.ansi.bright_blue": "#56949f",
        "terminal.ansi.magenta": "#907aa9",
        "terminal.ansi.bright_magenta": "#907aa9",
        "terminal.ansi.cyan": "#d7827e",
        "terminal.ansi.bright_cyan": "#d7827e",
        "terminal.ansi.white": "#797593",
        "terminal.ansi.bright_white": "#464261",
        "players": [
          {
            "cursor": "#464261",
            "background": "#d7827e",
            "selection": "#dfdad980"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#9893a5"
          },
          "string": {
            "color": "#286983"
          },
          "keyword": {
            "color": "#d7827e"
          },
          "number": {
            "color": "#ea9d34"
          },
          "boolean": {
            "color": "#ea9d34"
          },
          "function": {
            "color": "#56949f"
          },
          "type": {
            "color": "#ea9d34"
          },
          "operator": {
            "color": "#d7827e"
          },
          "variable": {
            "color": "#464261"
          },
          "punctuation": {
            "color": "#797593"
          },
          "property": {
            "color": "#56949f"
          },
          "tag": {
            "color": "#b4637a"
          }
        }
      }
    }
  ]
}
