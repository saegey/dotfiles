{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dotfiles Desktop",
  "author": "dotfiles",
  "themes": [
    {
      "name": "Dotfiles Desktop",
      "appearance": "dark",
      "style": {
        "background": "#232136",
        "surface.background": "#2a273f",
        "elevated_surface.background": "#393552",
        "border": "#56526e",
        "border.focused": "#ea9a97",
        "text": "#e0def4",
        "text.muted": "#6e6a86",
        "text.accent": "#ea9a97",
        "icon": "#e0def4",
        "icon.muted": "#6e6a86",
        "editor.background": "#232136",
        "editor.foreground": "#e0def4",
        "editor.gutter.background": "#232136",
        "editor.line_number": "#6e6a86",
        "editor.active_line_number": "#ea9a97",
        "editor.active_line.background": "#393552",
        "panel.background": "#2a273f",
        "toolbar.background": "#2a273f",
        "tab_bar.background": "#2a273f",
        "tab.active_background": "#232136",
        "tab.inactive_background": "#2a273f",
        "status_bar.background": "#2a273f",
        "title_bar.background": "#2a273f",
        "title_bar.inactive_background": "#2a273f",
        "terminal.background": "#232136",
        "terminal.foreground": "#e0def4",
        "terminal.bright_foreground": "#908caa",
        "error": "#eb6f92",
        "warning": "#f6c177",
        "success": "#3e8fb0",
        "info": "#9ccfd8",
        "created": "#3e8fb0",
        "deleted": "#eb6f92",
        "modified": "#f6c177",
        "terminal.ansi.black": "#393552",
        "terminal.ansi.bright_black": "#6e6a86",
        "terminal.ansi.red": "#eb6f92",
        "terminal.ansi.bright_red": "#eb6f92",
        "terminal.ansi.green": "#3e8fb0",
        "terminal.ansi.bright_green": "#3e8fb0",
        "terminal.ansi.yellow": "#f6c177",
        "terminal.ansi.bright_yellow": "#f6c177",
        "terminal.ansi.blue": "#9ccfd8",
        "terminal.ansi.bright_blue": "#9ccfd8",
        "terminal.ansi.magenta": "#c4a7e7",
        "terminal.ansi.bright_magenta": "#c4a7e7",
        "terminal.ansi.cyan": "#ea9a97",
        "terminal.ansi.bright_cyan": "#ea9a97",
        "terminal.ansi.white": "#908caa",
        "terminal.ansi.bright_white": "#e0def4",
        "players": [
          {
            "cursor": "#e0def4",
            "background": "#ea9a97",
            "selection": "#44415a80"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#6e6a86"
          },
          "string": {
            "color": "#3e8fb0"
          },
          "keyword": {
            "color": "#ea9a97"
          },
          "number": {
            "color": "#f6c177"
          },
          "boolean": {
            "color": "#f6c177"
          },
          "function": {
            "color": "#9ccfd8"
          },
          "type": {
            "color": "#f6c177"
          },
          "operator": {
            "color": "#ea9a97"
          },
          "variable": {
            "color": "#e0def4"
          },
          "punctuation": {
            "color": "#908caa"
          },
          "property": {
            "color": "#9ccfd8"
          },
          "tag": {
            "color": "#eb6f92"
          }
        }
      }
    }
  ]
}
