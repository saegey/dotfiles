{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dotfiles Desktop",
  "author": "dotfiles",
  "themes": [
    {
      "name": "Dotfiles Desktop",
      "appearance": "dark",
      "style": {
        "background": "#002b36",
        "surface.background": "#002b36",
        "elevated_surface.background": "#073642",
        "border": "#586e75",
        "border.focused": "#268bd2",
        "text": "#839496",
        "text.muted": "#657b83",
        "text.accent": "#268bd2",
        "icon": "#839496",
        "icon.muted": "#657b83",
        "editor.background": "#002b36",
        "editor.foreground": "#839496",
        "editor.gutter.background": "#002b36",
        "editor.line_number": "#657b83",
        "editor.active_line_number": "#268bd2",
        "editor.active_line.background": "#073642",
        "panel.background": "#002b36",
        "toolbar.background": "#002b36",
        "tab_bar.background": "#002b36",
        "tab.active_background": "#002b36",
        "tab.inactive_background": "#002b36",
        "status_bar.background": "#002b36",
        "title_bar.background": "#002b36",
        "title_bar.inactive_background": "#002b36",
        "terminal.background": "#002b36",
        "terminal.foreground": "#839496",
        "terminal.bright_foreground": "#eee8d5",
        "error": "#dc322f",
        "warning": "#b58900",
        "success": "#859900",
        "info": "#268bd2",
        "created": "#859900",
        "deleted": "#dc322f",
        "modified": "#b58900",
        "terminal.ansi.black": "#073642",
        "terminal.ansi.bright_black": "#586e75",
        "terminal.ansi.red": "#dc322f",
        "terminal.ansi.bright_red": "#dc322f",
        "terminal.ansi.green": "#859900",
        "terminal.ansi.bright_green": "#859900",
        "terminal.ansi.yellow": "#b58900",
        "terminal.ansi.bright_yellow": "#b58900",
        "terminal.ansi.blue": "#268bd2",
        "terminal.ansi.bright_blue": "#268bd2",
        "terminal.ansi.magenta": "#d33682",
        "terminal.ansi.bright_magenta": "#d33682",
        "terminal.ansi.cyan": "#2aa198",
        "terminal.ansi.bright_cyan": "#2aa198",
        "terminal.ansi.white": "#eee8d5",
        "terminal.ansi.bright_white": "#fdf6e3",
        "players": [
          {
            "cursor": "#93a1a1",
            "background": "#268bd2",
            "selection": "#07364280"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#657b83"
          },
          "string": {
            "color": "#859900"
          },
          "keyword": {
            "color": "#268bd2"
          },
          "number": {
            "color": "#cb4b16"
          },
          "boolean": {
            "color": "#cb4b16"
          },
          "function": {
            "color": "#268bd2"
          },
          "type": {
            "color": "#b58900"
          },
          "operator": {
            "color": "#2aa198"
          },
          "variable": {
            "color": "#839496"
          },
          "punctuation": {
            "color": "#eee8d5"
          },
          "property": {
            "color": "#268bd2"
          },
          "tag": {
            "color": "#dc322f"
          }
        }
      }
    }
  ]
}
