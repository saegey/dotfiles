# Machine-specific settings load first, so a live forwarded agent can be
# selected conditionally. The shared Home Assistant setting below remains
# the fallback when no forwarded agent is available.
Include ~/.ssh/config.local

# Home Assistant uses the local 1Password agent unless config.local detects
# an active forwarded agent for this SSH session.
Host homeassistant 192.168.2.91
  HostName 192.168.2.91
  User root
  IdentityAgent ~/.1password/agent.sock

# Add optional Conductor, OrbStack and Colima includes in config.local
# on the machines where those tools are installed.

# --- Specific hosts ---

Host github.com
  HostName github.com
  User git
  # Select a work-only identity in ~/.ssh/config.local on the work machine.
  # The shared config intentionally leaves this host unpinned so each machine
  # can use its available local or 1Password identity.

Host github-saegey
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_rsa_personal_github.pub

Host beelink
  HostName beelink
  User saegey
