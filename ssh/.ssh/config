# Machine-specific overrides (not committed). Included first so its
# host entries take precedence (SSH uses the first matching value).
Include ~/.ssh/config.local

# Add optional Conductor, OrbStack and Colima includes in config.local
# on the machines where those tools are installed.

# --- Specific hosts (must precede `Host *` so their IdentityAgent wins) ---

Host github.com
  HostName github.com
  User git
  # Select a work-only identity in ~/.ssh/config.local on the work machine.
  # The shared config intentionally leaves this host unpinned so each machine
  # can use its available local or 1Password identity.

Host github-saegey
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_rsa_personal_github.pub

Host beelink
  HostName beelink
  User saegey

Host grooovenet
  HostName ssh-grooovenet.vinylplay.cc
  User ben
  ProxyCommand cloudflared access ssh --hostname %h

# Set IdentityAgent for each host in ~/.ssh/config.local if needed.

Host homeassistant
    HostName 192.168.2.91
    User root
