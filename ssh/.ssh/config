# Home Assistant deploys use the local machine's 1Password SSH agent.
# Linux uses ~/.1password/agent.sock directly; macOS creates that symlink
# to its 1Password-managed socket. Keep this before config.local so a
# forwarded-agent rule cannot redirect HA authentication to another machine.
Host homeassistant 192.168.2.91
  HostName 192.168.2.91
  User root
  IdentityAgent ~/.1password/agent.sock

# Machine-specific overrides (not committed). Included after the HA agent
# selection above; other host settings remain machine-local.
Include ~/.ssh/config.local

# Add optional Conductor, OrbStack and Colima includes in config.local
# on the machines where those tools are installed.

# --- Specific hosts ---

Host github.com
  HostName github.com
  User git
  # Select a work-only identity in ~/.ssh/config.local on the work machine.
  # The shared config intentionally leaves this host unpinned so each machine
  # can use its available local or 1Password identity.

Host github-saegey
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_rsa_personal_github.pub

Host beelink
  HostName beelink
  User saegey
