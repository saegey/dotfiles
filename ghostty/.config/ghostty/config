# Ghostty config for Adam

# Font
font-family = "JetBrains Mono"
font-size = 14
font-thicken = true
font-thicken-strength = 70

# Theme
theme = dark:Catppuccin Frappe,light:Catppuccin Latte
background-opacity = 0.96
background-blur-radius = 20

# Window
window-padding-x = 12
window-padding-y = 10
# Hide the titlebar while keeping macOS window borders and rounded corners.
window-decoration = true
window-inherit-working-directory = true
macos-titlebar-style = hidden
macos-dock-drop-behavior = new-window
quit-after-last-window-closed = true

# Notifications

# Shell
command = /bin/zsh

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
# 10 MiB per terminal surface. Allocated lazily, so this only uses memory for
# output that is actually retained (e.g. long Terraform plans).
scrollback-limit = 10485760

# Clipboard
copy-on-select = false
clipboard-read = allow
clipboard-write = allow

# Mouse
mouse-hide-while-typing = true

# URLs
link-url = true

# macOS behavior
macos-option-as-alt = true
macos-non-native-fullscreen = false

# Keybinds
keybind = cmd+w=close_surface
keybind = cmd+shift+]=unbind
keybind = cmd+shift+[=unbind
# Let Herdr handle sidebar visibility with Command+[.
keybind = cmd+[=unbind
# Let Herdr create pane splits inside its workspace.
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
# The persistent PR review dashboard belongs to Herdr.
keybind = cmd+shift+r=unbind
# Let Herdr navigate its panes instead of Ghostty's own splits.
keybind = cmd+alt+left=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+enter=toggle_fullscreen
# Send Ctrl+Alt+Shift+K explicitly so Command+K works without relying on
# the foreground application requesting the terminal's Super-key protocol.
keybind = cmd+k=text:\x1b[107;8u
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Free cmd+t from Ghostty's own default new_tab so Herdr can claim it instead
# (see new_tab in ~/.config/herdr/config.toml). Only one form is bound by
# default (no digit_t-style duplicate).
keybind = cmd+t=unbind

# Free cmd+1..9 from Ghostty's own default tab-switching (goto_tab:1..8,
# last_tab) so Herdr can claim them instead (see switch_tab in
# ~/.config/herdr/config.toml). Both the logical-char and physical-digit forms
# are bound by default, so both need unbinding.
keybind = cmd+1=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+2=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+3=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+4=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+5=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+9=unbind
