#!/usr/bin/env python3
"""Open the persistent SkySafe Review workspace, or run its PR dashboard."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


def herdr(*args):
    result = subprocess.run([os.environ.get('HERDR_BIN_PATH', 'herdr'), *args],
                            check=True, capture_output=True, text=True, timeout=15)
    # pane run succeeds without printing a JSON response on this Herdr build.
    return json.loads(result.stdout)['result'] if result.stdout.strip() else {}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dashboard', action='store_true')
    parser.add_argument('--no-focus', action='store_true')
    args = parser.parse_args()
    try:
        if os.environ.get('HERDR_ENV') != '1':
            raise RuntimeError('Run inside Herdr.')
        if args.dashboard:
            login = subprocess.run(['gh', 'api', 'user', '--jq', '.login'], capture_output=True,
                                   text=True, check=True, timeout=20).stdout.strip()
            if login != 'adam-skysafe':
                raise RuntimeError('Review expects adam-skysafe. Run gh auth switch --user adam-skysafe, then retry.')
            config = Path.home() / '.config/gh-dash/review.yml'
            if not config.is_file():
                raise RuntimeError('Link the gh-dash package first; review.yml is missing.')
            os.execvp('gh', ['gh', 'dash', '--config', str(config)])
        workspaces = herdr('workspace', 'list')['workspaces']
        existing = next((w for w in workspaces if w.get('tokens', {}).get('review_dashboard') == '1'), None)
        if existing is None:
            existing = next((w for w in workspaces if w.get('label') == 'Review' and not w.get('worktree')), None)
        if existing:
            workspace = existing['workspace_id']
        else:
            result = herdr('workspace', 'create', '--cwd', str(Path.home() / 'Projects'),
                           '--label', 'Review', '--env', 'HERDR_REVIEW=1', '--no-focus')
            workspace = result['workspace']['workspace_id']
            pane = result['root_pane']['pane_id']
            herdr('pane', 'run', pane, '"$HOME/.local/bin/herdr-review" --dashboard')
        herdr('workspace', 'report-metadata', workspace, '--source', 'dotfiles:review',
              '--token', 'review_dashboard=1')
        if not args.no_focus:
            herdr('workspace', 'focus', workspace)
        print('Review workspace: ' + workspace)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        details = getattr(error, 'stderr', '') or str(error)
        print('Could not open Review: ' + details.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
