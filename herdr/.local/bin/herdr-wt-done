#!/usr/bin/env bash
# Finish a worktree task from inside its Herdr app space: run the repo's own
# scripts/worktree-rm.sh (unsaved-work guard, docker stack, caddy route, ports,
# git worktree removal), then close the space. Other repos use
# `git worktree remove`. --force bypasses unsaved-work checks.
# Wired up per repo in
# ~/.config/herdr/repo-scripts.json, so the repo itself needs no herdr glue.
#
# herdr-repo-tasks runs commands from the *main* checkout, so the worktree is
# resolved from HERDR_ACTIVE_PANE_CWD (the folder it was opened in), not $PWD.
set -euo pipefail

die() {
  echo "$1" >&2
  exit 1
}

force=0
for arg in "$@"; do
  case "$arg" in
    --force|-f) force=1 ;;
    --help|-h) echo "usage: herdr-wt-done [--force]"; exit 0 ;;
    *) die "Unknown argument: $arg (usage: herdr-wt-done [--force])" ;;
  esac
done

command -v jq >/dev/null 2>&1 || die "herdr-wt-done needs jq (brew install jq)"
command -v herdr-app >/dev/null 2>&1 || die "Not inside Herdr: herdr-app is not on PATH."
spaces="$(herdr-app ls 2>/dev/null)" || die "Not inside Herdr: herdr-app ls failed."
jq -e '.spaces' >/dev/null 2>&1 <<<"$spaces" || die "Not inside Herdr: herdr-app ls returned no spaces."

cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
wt="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || die "Not in a git checkout: $cwd"
[[ -f "$wt/.git" ]] || die "Refusing: $wt is the main checkout, not a linked worktree."
wt="$(cd "$wt" && pwd -P)"

resolve() { (cd "$1" 2>/dev/null && pwd -P); }

# The space to close: the one holding this terminal, else the only local space
# opened on this worktree. Either way its folder must be this worktree before
# anything is removed or closed.
space=""
folder=""
if [[ -n "${HC_TERMINAL_ID:-}" ]]; then
  IFS=$'\t' read -r space folder < <(jq -r --arg t "$HC_TERMINAL_ID" '
    [.spaces[] | select(any(.tabs[]?.terminals[]?; .terminal == $t))][0]
    | select(. != null) | [.id, (.folder // "")] | @tsv' <<<"$spaces") || true
fi
if [[ -z "$space" ]]; then
  matches=()
  while IFS=$'\t' read -r id dir; do
    [[ -n "$id" && "$(resolve "$dir")" == "$wt" ]] && matches+=("$id")
  done < <(jq -r '.spaces[] | select((.machine // "") == "") | [.id, (.folder // "")] | @tsv' <<<"$spaces")
  [[ ${#matches[@]} -gt 0 ]] || die "Could not find the Herdr space for $wt."
  [[ ${#matches[@]} -eq 1 ]] || die "Refusing: more than one Herdr space is open on $wt."
  space="${matches[0]}"
  folder="$wt"
fi
registered="$(resolve "$folder")" || die "Space $space's folder is unavailable: $folder"
[[ "$registered" == "$wt" ]] || die "Refusing: space $space belongs to ${registered:-$folder}, not $wt."

# Use cleanup helpers from this repository's main checkout if the linked
# worktree is older and does not contain them yet.
main="$(git -C "$wt" worktree list --porcelain | sed -n '1s/^worktree //p')"
cleanup="$wt/scripts/worktree-rm.sh"
if [[ ! -x "$cleanup" ]]; then
  cleanup="$main/scripts/worktree-rm.sh"
fi
cd "$main"

if [[ "$force" -eq 0 ]]; then
  untracked=all
  [[ ! -x "$cleanup" ]] || untracked=no
  dirty="$(git -C "$wt" status --porcelain --untracked-files="$untracked")" \
    || die "Could not check unsaved work; leaving the worktree untouched."
  [[ -z "$dirty" ]] || die "Refusing: $wt has unsaved work. Commit first, or use --force."
  if git -C "$wt" rev-parse --verify '@{u}' >/dev/null 2>&1; then
    unpushed="$(git -C "$wt" rev-list --count '@{u}..HEAD')" \
      || die "Could not check unpushed commits; leaving the worktree untouched."
    [[ "$unpushed" -eq 0 ]] || die "Refusing: $wt has unpushed commits. Push first, or use --force."
  fi
fi

# Teardown by Compose labels, rather than a guessed project name or compose
# file. Finish and verify this before either removal path can delete anything.
# Docker failures are fatal even with --force.
python3 - "$wt" <<'PY'
import json
from pathlib import Path
import shutil
import subprocess
import sys


def docker(*args):
    return subprocess.run(['docker', *args], capture_output=True, text=True,
                          check=True, timeout=120).stdout.strip()


def containers():
    ids = docker('ps', '--all', '--quiet', '--filter', 'label=com.docker.compose.project').split()
    return json.loads(docker('inspect', '--type', 'container', *ids)) if ids else []


def labels(container):
    return container.get('Config', {}).get('Labels') or {}


def belongs(container, checkout):
    directory = labels(container).get('com.docker.compose.project.working_dir', '')
    if not directory or not Path(directory).is_absolute():
        return False
    path = Path(directory).resolve()
    return path == checkout or checkout in path.parents


try:
    if shutil.which('docker') is None:
        print('Docker is not installed; no local stack to stop.')
        sys.exit(0)
    checkout = Path(sys.argv[1]).resolve()
    existing = containers()
    projects = {labels(c)['com.docker.compose.project'] for c in existing if belongs(c, checkout)}
    # A shared Compose project must not tear down another checkout's resources.
    for c in existing:
        if labels(c).get('com.docker.compose.project') in projects and not belongs(c, checkout):
            raise RuntimeError('Compose project is shared with another checkout; refusing teardown')
    for project in sorted(projects):
        print('Bringing down Docker stack: ' + project, flush=True)
        for c in existing:
            if labels(c).get('com.docker.compose.project') == project:
                docker('rm', '--force', '--volumes', c['Id'])
        for resource in ['volume', 'network']:
            ids = docker(resource, 'ls', '--quiet', '--filter',
                         'label=com.docker.compose.project=' + project).split()
            for resource_id in ids:
                docker(resource, 'rm', resource_id)
    if any(belongs(c, checkout) for c in containers()):
        raise RuntimeError('Worktree still has Compose containers after teardown')
except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
    print('Stack teardown failed; leaving worktree and Herdr space intact: ' + str(error),
          file=sys.stderr)
    sys.exit(1)
PY

# Closing the space kills the terminal this runs in, so it goes last and runs
# outside it: as an hc worker that outlives this terminal, else under nohup.
close_space() {
  local args
  args="$(jq -cn --arg id "$space" '{id: $id, confirmed: true}')"
  echo "Closing Herdr space $space ..."
  if [[ -n "${HC_TERMINAL_ID:-}" ]] && command -v hc >/dev/null 2>&1 \
    && hc run --bg --rm --no-notify --outlive-parent --cwd "$main" -- herdr-app "do" space.close "$args" >/dev/null 2>&1; then
    return
  fi
  nohup herdr-app "do" space.close "$args" >/dev/null 2>&1 &
  disown
}

if [[ ! -x "$cleanup" ]]; then
  args=(worktree remove)
  [[ "$force" -eq 0 ]] || args+=(--force)
  echo "Removing worktree $wt ..."
  # git refuses dirty or locked worktrees unless --force; then nothing is closed.
  git -C "$main" "${args[@]}" "$wt"
else
  # Resolve everything above before this runs: it deletes the checkout. It
  # refuses (non-zero, nothing removed) on unsaved work unless --force.
  args=("$wt")
  [[ "$force" -eq 0 ]] || args=(--force "$wt")
  "$cleanup" "${args[@]}"
fi

close_space
