#!/usr/bin/env python3
"""Read-only Docker Compose status for Herdr and SketchyBar."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


def checkout(directory):
    path = Path(directory).resolve()
    return str(path.parent.parent) if path.parts[-2:] == ("docker", "localdev") else None


def summarize(containers):
    projects = {}
    for container in containers:
        name = container.get("project", "")
        directory = container.get("directory", "")
        if not (name == "localdev" or name.startswith("localdev-")):
            continue
        if not directory or not checkout(directory):
            continue
        if container.get("oneoff", "").lower() == "true":
            continue
        project = projects.setdefault((name, directory), {
            "name": name, "checkout": checkout(directory),
            "running": 0, "total": 0, "unhealthy": 0, "starting": 0,
        })
        project["total"] += 1
        if container.get("state") == "running":
            project["running"] += 1
            status = container.get("status", "").lower()
            project["unhealthy"] += "(unhealthy)" in status
            project["starting"] += "(health: starting)" in status
    values = sorted(projects.values(), key=lambda item: item["name"])
    return {"error": None, "running_stacks": sum(p["running"] > 0 for p in values),
            "projects": values}


def snapshot():
    fields = {
        "project": '(.Label "com.docker.compose.project")',
        "directory": '(.Label "com.docker.compose.project.working_dir")',
        "oneoff": '(.Label "com.docker.compose.oneoff")',
        "state": ".State", "status": ".Status",
    }
    template = "{" + ",".join('"' + key + '":{{json ' + value + '}}'
                                 for key, value in fields.items()) + "}"
    try:
        result = subprocess.run([
            "docker", "ps", "--all", "--filter", "label=com.docker.compose.project",
            "--format", template,
        ], capture_output=True, text=True, timeout=8, check=True)
        return summarize([json.loads(line) for line in result.stdout.splitlines() if line])
    except (OSError, subprocess.SubprocessError, ValueError):
        return {"error": "Docker unavailable", "running_stacks": None, "projects": []}


def workspace_token(state, workspace):
    worktree = workspace.get("worktree") or {}
    path = worktree.get("checkout_path")
    if not path:
        return None
    projects = [p for p in state["projects"] if p["checkout"] == str(Path(path).resolve())]
    if not projects and worktree.get("repo_name") != "skysafe-cloud":
        return None
    if state["error"]:
        return "DEV ?"
    if not projects:
        return "DEV off"
    running = sum(p["running"] for p in projects)
    total = sum(p["total"] for p in projects)
    suffix = " !" if any(p["unhealthy"] for p in projects) or 0 < running < total else ""
    if not suffix and any(p["starting"] for p in projects):
        suffix = " ~"
    return "DEV {}/{}{}".format(running, total, suffix)


def report_herdr(state):
    # Only operate in a real Herdr caller context; never use another client's focus.
    if os.environ.get("HERDR_ENV") != "1":
        raise RuntimeError("Run --herdr inside a Herdr terminal or plugin")
    binary = os.environ.get("HERDR_BIN_PATH", "herdr")
    result = subprocess.run([binary, "workspace", "list"], capture_output=True,
                            text=True, check=True, timeout=8)
    workspaces = json.loads(result.stdout)["result"]["workspaces"]
    for workspace in workspaces:
        token = workspace_token(state, workspace)
        args = [binary, "workspace", "report-metadata", workspace["workspace_id"],
                "--source", "dotfiles:dev-stacks"]
        args += ["--token", "dev_stack=" + token] if token else ["--clear-token", "dev_stack"]
        subprocess.run(args, capture_output=True, text=True, check=True, timeout=8)
    print("Refreshed dev-stack status for {} Herdr workspaces".format(len(workspaces)))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="print a read-only Docker snapshot")
    parser.add_argument("--herdr", action="store_true", help="refresh Herdr workspace badges")
    args = parser.parse_args()
    state = snapshot()
    if args.herdr:
        try:
            report_herdr(state)
        except (RuntimeError, OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
            print("dev-stack-status: {}".format(error), file=sys.stderr)
            return 1
    else:
        print(json.dumps(state))
    return 0


if __name__ == "__main__":
    sys.exit(main())
