#!/usr/bin/env python3
"""One-line lounge status when docked, persistent player terminal when zoomed."""
import fcntl
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import pty
import re
import select
import signal
import struct
import subprocess
import sys
import termios
import time
import tty
import unicodedata

# Resolve once while the Stow link exists. A running controller must not depend
# on ~/.local/bin symlinks remaining present throughout a dotfiles update.
HELPER_DIR = Path(__file__).resolve().parent


def load_dock():
    path = HELPER_DIR / 'herdr-music-dock'
    loader = importlib.machinery.SourceFileLoader('music_dock_api', str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def expanded(api):
    panes = api('session.snapshot')['snapshot']['panes']
    music = [p for p in panes if p.get('tokens', {}).get('music_lounge') == '1']
    if len(music) != 1 or music[0].get('tokens', {}).get('music_hidden') == '1':
        return False
    pane = music[0]
    layout = api('layout.export', tab_id=pane['tab_id'])['layout']
    return layout['zoomed'] and layout['focused_pane_id'] == pane['pane_id']


def status_line(text, width):
    # One terminal row, including wide Unicode titles. Do not replay terminal
    # control sequences from the status command in the parent terminal.
    text = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', text)
    result, cells = [], 0
    for char in ' '.join(text.splitlines()):
        if unicodedata.category(char).startswith('C'):
            continue
        size = 0 if unicodedata.combining(char) else (2 if unicodedata.east_asian_width(char) in 'WF' else 1)
        if cells + size > max(0, width - 1):
            break
        result.append(char)
        cells += size
    return ''.join(result)


def resize(fd, rows, cols):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', rows, cols, 0, 0))


def stop_status(process):
    """Stop a status request without letting signal errors or pipes block the UI."""
    if process.poll() is None:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            # The group may have exited or may no longer be signalable. Try
            # the direct child as well; losing permission must not crash the UI.
            try:
                process.kill()
            except (ProcessLookupError, PermissionError):
                pass
    try:
        process.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        # A descendant can retain stdout even after the direct child exits.
        # Close our pipe rather than waiting indefinitely for that descendant.
        if process.stdout is not None:
            process.stdout.close()


class Player:
    def __init__(self, command, rows, cols):
        if not command.is_file() or not os.access(command, os.X_OK):
            raise FileNotFoundError('Music launcher is missing or not executable: ' + str(command))
        self.pid, self.fd = pty.fork()
        self.alive = True
        if self.pid == 0:
            resize(0, rows, cols)
            os.execv(str(command), [str(command), '--player'])
        resize(self.fd, rows, cols)

    def redraw(self, rows, cols):
        # A real size change prompts Ink to repaint after its output was hidden.
        resize(self.fd, max(1, rows - 1), cols)
        time.sleep(0.03)
        resize(self.fd, rows, cols)

    def close(self):
        if self.alive:
            try:
                group = os.tcgetpgrp(self.fd)
                if group > 1 and group != os.getpgrp():
                    os.killpg(group, signal.SIGHUP)
            except (OSError, ProcessLookupError):
                pass
            try:
                os.kill(self.pid, signal.SIGHUP)
            except (ProcessLookupError, PermissionError):
                pass
        os.close(self.fd)
        try:
            os.waitpid(self.pid, os.WNOHANG)
        except ChildProcessError:
            pass


def main():
    dock = load_dock()
    if not os.environ.get('HERDR_SOCKET_PATH'):
        if '--cached-status' not in sys.argv[1:]:
            print('Run herdr-music inside Herdr; use --status for a standalone status read.', file=sys.stderr)
        return
    cache = dock.status_cache()
    if '--cached-status' in sys.argv[1:]:
        try:
            if time.time() - cache.stat().st_mtime < 10:
                print(cache.read_text().strip())
        except OSError:
            pass
        return
    cache.parent.mkdir(parents=True, exist_ok=True)
    command = HELPER_DIR / 'herdr-music'
    if not command.is_file() or not os.access(command, os.X_OK):
        print('Music launcher is missing or not executable: ' + str(command), file=sys.stderr)
        return
    if not os.isatty(0):
        print('The music view needs an interactive terminal; use --status for plain output.', file=sys.stderr)
        return
    original = termios.tcgetattr(0)
    player, poll = None, None
    full, previous, last_size = False, None, None
    status = 'Loading lounge…'
    next_mode = next_status = 0
    def terminate(*_):
        raise KeyboardInterrupt
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, terminate)
    try:
        tty.setraw(0)
        os.write(1, b'\x1b[?1049h\x1b[?25l')
        while True:
            now = time.monotonic()
            size = os.get_terminal_size(0)
            if now >= next_mode:
                try:
                    full = expanded(dock.api)
                except (OSError, RuntimeError, KeyError, ValueError):
                    full = False
                next_mode = now + 0.25
            if full != previous or size != last_size:
                os.write(1, b'\x1b[?1049h\x1b[2J\x1b[H\x1b[?25l')
                if full:
                    if player is None:
                        player = Player(command, size.lines, size.columns)
                    elif player.alive:
                        player.redraw(size.lines, size.columns)
                previous, last_size = full, size
            if now >= next_status and poll is None:
                try:
                    poll = subprocess.Popen([str(command), '--status'], stdout=subprocess.PIPE,
                                            stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    status = 'Music launcher unavailable; retrying…'
                started = now
                next_status = now + 2
            if poll is not None:
                if poll.poll() is not None:
                    output = poll.communicate()[0].decode('utf-8', 'replace').strip()
                    status = output if poll.returncode == 0 and output else 'Lounge unavailable'
                    poll = None
                elif now - started > 5:
                    stop_status(poll)
                    poll = None
                    status = 'Lounge unavailable'
                if poll is None:
                    temporary = cache.with_suffix('.tmp')
                    temporary.write_text(status_line(status, 72) + '\n')
                    temporary.replace(cache)
            if not full:
                text = status_line(status, size.columns)
                os.write(1, ('\x1b[H\x1b[2K\x1b[38;2;205;214;244m' + text + '\x1b[0m\x1b[?25l').encode())
            inputs = [0] + ([player.fd] if player and player.alive else [])
            ready, _, _ = select.select(inputs, [], [], 0.1)
            if 0 in ready:
                data = os.read(0, 4096)
                if not data:
                    break
                if full and player and player.alive:
                    os.write(player.fd, data)
                elif b'\x03' in data or data == b'q':
                    break
            if player and player.alive and player.fd in ready:
                try:
                    output = os.read(player.fd, 65536)
                except OSError:
                    output = b''
                if not output:
                    player.alive = False
                    if full:
                        subprocess.run([str(HELPER_DIR / 'herdr-music-dock')], timeout=15)
                    player.close()
                    player = None
                elif full:
                    os.write(1, output)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            if poll is not None:
                stop_status(poll)
            if player:
                player.close()
            cache.unlink(missing_ok=True)
        finally:
            try:
                os.write(1, b'\x1b[?1049l\x1b[?25h\x1b[0m')
            finally:
                termios.tcsetattr(0, termios.TCSADRAIN, original)


if __name__ == '__main__':
    main()
